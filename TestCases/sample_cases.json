{
  "description": "CSET302 Automata Simulator Milestone-II Test Suite",
  "test_cases": [
    {
      "id": "TC01",
      "name": "Ends in 01 (Canonical Example)",
      "description": "Standard NFA recognizing binary strings that terminate with the substring '01'",
      "states": ["q0", "q1", "q2"],
      "alphabet": ["0", "1"],
      "start": "q0",
      "accept": ["q2"],
      "transitions": {
        "q0": { "0": ["q0", "q1"], "1": ["q0"] },
        "q1": { "0": [], "1": ["q2"] },
        "q2": { "0": [], "1": [] }
      },
      "strings": [
        { "input": "101", "expected": true, "path": ["D0", "D0", "D1", "D2"] },
        { "input": "01", "expected": true, "path": ["D0", "D1", "D2"] },
        { "input": "0001", "expected": true, "path": ["D0", "D1", "D1", "D1", "D2"] },
        { "input": "100", "expected": false, "path": ["D0", "D0", "D1", "D1"] },
        { "input": "", "expected": false, "path": ["D0"] }
      ]
    },
    {
      "id": "TC02",
      "name": "Contains substring 00",
      "description": "NFA recognizing binary strings containing at least two consecutive zeros",
      "states": ["q0", "q1", "q2"],
      "alphabet": ["0", "1"],
      "start": "q0",
      "accept": ["q2"],
      "transitions": {
        "q0": { "0": ["q0", "q1"], "1": ["q0"] },
        "q1": { "0": ["q2"], "1": [] },
        "q2": { "0": ["q2"], "1": ["q2"] }
      },
      "strings": [
        { "input": "00", "expected": true },
        { "input": "1001", "expected": true },
        { "input": "10101", "expected": false },
        { "input": "0", "expected": false }
      ]
    },
    {
      "id": "TC03",
      "name": "Dead / Trap State Generator",
      "description": "Incomplete NFA demonstrating automatic generation and retention of dead trap state {∅}",
      "states": ["s", "f"],
      "alphabet": ["a", "b"],
      "start": "s",
      "accept": ["f"],
      "transitions": {
        "s": { "a": ["f"], "b": [] },
        "f": { "a": [], "b": ["f"] }
      },
      "strings": [
        { "input": "a", "expected": true },
        { "input": "ab", "expected": true },
        { "input": "b", "expected": false },
        { "input": "aa", "expected": false }
      ]
    }
  ]
}